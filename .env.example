# Sentinel_OS environment configuration
# Copy to `.env` and adjust. `.env` is git-ignored; this example file is tracked.
# All settings have safe defaults in app/core/config.py — override only what you need.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Sentinel_OS
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. Defaults cover React (3000) and Streamlit (8501).
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ── LLM provider (Phase 3 onward) ─────────────────────────────────────────────
# ollama = local, air-gapped (production).  groq = cloud, DEV ONLY — never deploy.
LLM_PROVIDER=ollama
# LLM_TIMEOUT_S=120           # per-request ceiling; cold model loads run 5-15 s+

# Ollama (production). Defaults below match app/core/config.py — override only to
# point at a remote daemon or to swap model tags.
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_KEEP_ALIVE=1m        # keep a model warm between back-to-back calls (§4)
# OLLAMA_MODEL_GENERAL=llama3.1:8b          # routing + drafting
# OLLAMA_MODEL_CODER=qwen2.5-coder:7b       # code + math
# OLLAMA_MODEL_VISION=qwen2.5-vl:latest     # image / scanned-PDF OCR

# Groq (LOCAL DEV ONLY). Set these in your git-ignored .env when LLM_PROVIDER=groq.
# GROQ_API_KEY=gsk_...                      # required when LLM_PROVIDER=groq
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL_GENERAL=openai/gpt-oss-20b
# GROQ_MODEL_CODER=qwen/qwen3.6-27b
# GROQ_MODEL_VISION=qwen/qwen3.6-27b

# ── Code sandbox (Phase 2) ───────────────────────────────────────────────────
# Base image for the Docker code sandbox. Must be pre-pulled: docker pull <image>.
# The embedding model is fixed (all-MiniLM-L6-v2) and not env-configurable.
SANDBOX_IMAGE=python:3.12-alpine
